# Cloudflare Workers static assets: publish ONLY the mission site.
# Everything else in this repository (evidence package, reference manuals,
# test logs and tooling) stays private, per AGENTS.md. Last matching rule wins.
/*
!/index.html
!/tmp/
/tmp/*
!/tmp/three-r128.js
!/kassel-mission-interactive-v4/
/kassel-mission-interactive-v4/*
!/kassel-mission-interactive-v4/*.html
!/kassel-mission-interactive-v4/*.js
!/kassel-mission-interactive-v4/*.glb
!/kassel-mission-interactive-v4/vendor/
/kassel-mission-interactive-v4/vendor/*.txt
/kassel-mission-interactive-v4/verify*.js
/kassel-mission-interactive-v4/test-*.js
/kassel-mission-interactive-v4/audit-*.js
/kassel-mission-interactive-v4/build-*.js
/kassel-mission-interactive-v4/m1-runtime-fixture.js
/kassel-mission-interactive-v4/reconstruct-navigation.js
